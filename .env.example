# Google Gemini API (for principle extraction from transcripts)
GEMINI_API_KEY=
# A second key (another Google project, so its own quota): used when the main key hits a quota limit.
GEMINI_API_KEY_BACKUP=
# Leave at 0: the reply shape is stated by prompts/extract_prompt.txt. 1 = ask the API for a schema-enforced reply instead.
GEMINI_USE_STRUCTURED_OUTPUT=0

# Models: leave GEMINI_MODELS (and GEMINI_MODELS_LISTEN) UNSET. The chain is then discovered from Google and ordered by what works
# (src/lifecompass/modelchain.py). Setting it pins a comma-separated chain, strongest first, and a pin wins over the discovery.
# GEMINI_MODELS=

# Folder where you drop your manually-enhanced images, before clicking the
# "finished" bookmarklet. Leave unset to use
# data/manual_enhanced_incoming/ inside the project folder.
MANUAL_ENHANCED_DIR=

# Telegram bot (for daily resurfacing -- sends direct messages to you)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How many principles to resurface per day: config.toml [resurface] daily_count (not here any more).
